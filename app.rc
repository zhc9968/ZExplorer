// ZExplorer 资源脚本（纯 ASCII）
#include <windows.h>

// 101 = IDI_APP，代码里用 MAKEINTRESOURCEW(101) 加载
101 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Zufy"
            VALUE "FileDescription", "ZExplorer"
            VALUE "FileVersion", "0.1.1.0"
            VALUE "InternalName", "ZExplorer"
            VALUE "OriginalFilename", "ZExplorer.exe"
            VALUE "ProductName", "ZExplorer"
            VALUE "ProductVersion", "0.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
